# Bannuar's Supabase project (Project Settings -> API). Both values are public by design:
# row level security in the database decides what the website may do.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: the HR portal's address, shown as "Staff sign-in" in the footer
PUBLIC_PORTAL_URL=
