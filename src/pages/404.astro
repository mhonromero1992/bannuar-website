---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" page="lost" dock={false}>
  <section class="lost section--night on-night">
    <div class="pagehead__sky" aria-hidden="true"></div>
    <div class="wrap" style="position:relative;padding-top:120px;padding-bottom:80px">
      <p class="pagehead__label"><span class="beacon" aria-hidden="true"></span><span class="label">404</span></p>
      <h1>This page is not on the roster</h1>
      <p class="lede">The link may be old or mistyped. These pages are on duty:</p>
      <div class="hero__actions">
        <a class="btn" href="/">Go to the home page</a>
        <a class="btn btn--line" href="/careers/">See the open posts</a>
      </div>
    </div>
  </section>
</Base>
