---
interface Props { label: string; title: string; lede?: string; id?: string }
const { label, title, lede, id = 'page-title' } = Astro.props;
const hasAside = Astro.slots.has('default');
---
<section class="pagehead on-night" aria-labelledby={id}>
  <div class="pagehead__sky" aria-hidden="true"></div>
  <div class="wrap">
    <div class:list={['pagehead__wrap', { pagehead__grid: hasAside }]}>
      <div class="pagehead__wrap">
        <p class="pagehead__label"><span class="beacon" aria-hidden="true"></span><span class="label">{label}</span></p>
        <h1 id={id}>{title}</h1>
        {lede && <p class="lede">{lede}</p>}
        <slot name="actions" />
      </div>
      {hasAside && <slot />}
    </div>
  </div>
</section>
