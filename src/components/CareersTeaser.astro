---
import Checklist from './Checklist.astro';
---
<section class="section" id="careers" aria-labelledby="careers-title">
  <div class="wrap careers__grid">
    <div class="careers__text">
      <p class="label muted">Careers</p>
      <h2 class="h2" id="careers-title">Apply as a security guard or lady guard</h2>
      <p class="lede">
        Send your application from your phone in a few minutes. It goes straight to Bannuar's HR
        office, with the open post you choose.
      </p>
      <div class="careers__actions">
        <a class="btn" href="/careers/#apply">Apply as a guard</a>
        <a class="btn btn--line" href="/careers/#openings">See the open posts</a>
      </div>
    </div>
    <Checklist id="home-docs" />
  </div>
</section>
