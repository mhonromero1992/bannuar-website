---
/* The office at night in line and light: a two-storey front, three lit windows, a street lamp, and
   one gold beacon at the door (a guard on duty, the site's identity motif). No signage, no text. */
const windows = [
  { x: 168, lit: true }, { x: 228, lit: false }, { x: 288, lit: true },
  { x: 348, lit: false }, { x: 408, lit: true }, { x: 468, lit: false },
];
---
<svg viewBox="0 0 640 512" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="oa-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#08111f" />
      <stop offset="1" stop-color="#16294a" />
    </linearGradient>
    <radialGradient id="oa-lamp" cx="0.5" cy="0" r="1">
      <stop offset="0" stop-color="#f2c230" stop-opacity="0.42" />
      <stop offset="1" stop-color="#f2c230" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="oa-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#f2c230" stop-opacity="0.9" />
      <stop offset="0.3" stop-color="#f2c230" stop-opacity="0.35" />
      <stop offset="1" stop-color="#f2c230" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="oa-win" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffe3a3" />
      <stop offset="1" stop-color="#f2b44a" />
    </linearGradient>
  </defs>
  <rect width="640" height="512" fill="url(#oa-sky)" />
  <g fill="#eef2f7" opacity="0.6">
    <circle cx="70" cy="60" r="1.4" /><circle cx="190" cy="40" r="1.1" /><circle cx="300" cy="74" r="1.5" />
    <circle cx="420" cy="36" r="1.2" /><circle cx="560" cy="68" r="1.6" /><circle cx="600" cy="120" r="1" />
    <circle cx="120" cy="118" r="1" /><circle cx="500" cy="104" r="1.1" />
  </g>
  <rect x="0" y="404" width="640" height="108" fill="#0b1626" />
  <line x1="0" y1="404" x2="640" y2="404" stroke="#2a4060" stroke-width="1.5" />
  <g stroke="#f2c230" stroke-width="3" stroke-linecap="round" opacity="0.32">
    <line x1="20" y1="462" x2="70" y2="462" /><line x1="130" y1="462" x2="180" y2="462" />
    <line x1="240" y1="462" x2="290" y2="462" /><line x1="350" y1="462" x2="400" y2="462" />
    <line x1="460" y1="462" x2="510" y2="462" /><line x1="570" y1="462" x2="620" y2="462" />
  </g>
  <g stroke="#3b5576" stroke-width="1.5">
    <rect x="132" y="150" width="400" height="254" fill="#101f36" />
    <line x1="126" y1="150" x2="538" y2="150" stroke-width="3" />
    <rect x="132" y="282" width="400" height="14" fill="#13253d" />
    <rect x="152" y="312" width="110" height="92" fill="#0d1a2d" />
    <rect x="402" y="312" width="110" height="92" fill="#0d1a2d" />
    <rect x="300" y="318" width="64" height="86" fill="#1a2c46" />
  </g>
  {windows.map((w) => (
    <rect x={w.x} y="180" width="40" height="72" rx="2" fill={w.lit ? 'url(#oa-win)' : '#0d1a2d'} stroke="#3b5576" stroke-width="1.5" opacity={w.lit ? 0.92 : 1} />
  ))}
  <rect x="306" y="324" width="52" height="76" fill="#f2c230" opacity="0.14" />
  <g>
    <polygon points="62,182 0,404 150,404" fill="url(#oa-lamp)" />
    <line x1="74" y1="404" x2="74" y2="176" stroke="#3b5576" stroke-width="5" />
    <path d="M74 176 q0 -14 -14 -14" fill="none" stroke="#3b5576" stroke-width="4" />
    <rect x="48" y="160" width="24" height="10" rx="3" fill="#ffe3a3" />
  </g>
  <circle cx="332" cy="396" r="34" fill="url(#oa-glow)" />
  <circle cx="332" cy="396" r="6" fill="#f2c230" />
</svg>
